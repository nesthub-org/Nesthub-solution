# NestHub Solution — Apache config for a client-side-routed SPA on Hostinger.

# Serve real files/directories as-is; everything else falls back to index.html
# so React Router can render the matching route (e.g. /careers).
#
# Prerendered routes live in folders (dist/careers/index.html), and Apache's
# default DirectorySlash would 301 /careers -> /careers/. Our canonicals and
# sitemap use the no-slash form, so turn that off and serve the folder's
# index.html directly; a slashed URL is redirected to the no-slash one instead.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # www -> bare domain (canonical host), in one hop with the HTTPS upgrade
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /careers/ -> /careers (only for what the browser actually asked for, so the
  # internal rewrite below can't loop back into it)
  RewriteCond %{THE_REQUEST} \s/+(.+?)/+[\s?]
  RewriteRule ^ /%1 [L,R=301]

  # /careers -> serve dist/careers/index.html without a redirect
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Long-lived caching for hashed build assets; never cache index.html itself
# so deploys are picked up immediately.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip common text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
